# Canonical list of environment variables. Copy to .env.local and fill in.
# .env.local is gitignored and must never be committed.

# --- Clerk authentication ---
# Browser-safe. Only the publishable key may reach the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Clerk hosted auth routes (scaffolded by `clerk init`).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
